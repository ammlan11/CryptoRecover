{
  "name": "@kurotrace/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js generate",
    "migrate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate deploy",
    "migrate:dev": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate dev",
    "validate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js validate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "prisma": "^6.19.0",
    "typescript": "^5.9.3"
  }
}
