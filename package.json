{
  "name": "kurotrace-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @kurotrace/web",
    "dev:admin": "npm run dev -w @kurotrace/admin",
    "build": "npm run db:generate && npm run build -w @kurotrace/web && npm run build -w @kurotrace/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run generate -w @kurotrace/db",
    "db:migrate": "npm run migrate -w @kurotrace/db",
    "demo": "npm run demo -w @kurotrace/admin",
    "sync-lists": "npm run sync-lists -w @kurotrace/admin",
    "email-preview": "npm run email-preview -w @kurotrace/services"
  }
}
