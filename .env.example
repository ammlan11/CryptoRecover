# Copy to .env (never commit .env). Generate keys with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Database (MySQL 8). Use separate least-privilege users for web and admin in production.
DATABASE_URL="mysql://kurotrace_app:CHANGE_ME@localhost:3306/kurotrace"

# Field encryption: ring of AES-256 keys, "keyId:base64key" comma-separated.
# The FIRST key encrypts new data; older keys stay for decryption during rotation.
# In production these come from the cloud KMS at boot, not from this file.
FIELD_ENCRYPTION_KEYS="k1:REPLACE_WITH_32_BYTE_BASE64_KEY"

# Separate key for blind indexes (lets us look up an email without storing it in plain text).
BLIND_INDEX_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"

# Public site URL (used for canonical URLs and cookies)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin terminal: comma-separated IPs or IPv4 CIDR ranges allowed to reach it.
ADMIN_ALLOWED_IPS="127.0.0.1,::1"
# Header that carries the real client IP. "cf-connecting-ip" behind Cloudflare.
# Only set this when the app is reachable exclusively through that proxy.
TRUSTED_IP_HEADER="x-forwarded-for"

# Email. "postmark" in production; "log" prints messages (with links) to the console, dev only.
EMAIL_PROVIDER="log"
POSTMARK_SERVER_TOKEN=""
EMAIL_FROM="Kuro Trace <no-reply@your-domain>"

# Evidence files (encrypted by the app before upload). "s3" in production: any private
# S3-compatible bucket (AWS S3, Cloudflare R2). "local" stores them in a folder, dev only.
EVIDENCE_STORAGE="local"
EVIDENCE_LOCAL_DIR=".evidence"
EVIDENCE_BUCKET=""
EVIDENCE_REGION="auto"
EVIDENCE_ENDPOINT=""          # e.g. https://<account-id>.r2.cloudflarestorage.com (leave empty for AWS)
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read by the S3 client from the environment.

# Bot check on public forms (Cloudflare Turnstile, free). Create a widget at
# dash.cloudflare.com -> Turnstile. In production the forms are refused until these are
# set, unless BOT_CHECK="off" is set on purpose (e.g. a private test server).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_HOSTNAMES=""        # e.g. kurotrace.com,www.kurotrace.com
BOT_CHECK=""

# Virus scanning of evidence uploads (ClamAV daemon, e.g. the clamav/clamav container).
# Without it, uploads are kept as "not yet scanned" and staff can't open them in
# production until scanned (run `npm run scan-pending -w @kurotrace/admin` on a schedule),
# unless MALWARE_SCAN="off" is set on purpose.
CLAMAV_HOST=""
CLAMAV_PORT="3310"
MALWARE_SCAN=""

# Admin terminal's public address. Security keys / passkeys are bound to its hostname,
# so set it before staff register keys. STAFF_SECURITY_KEY_ONLY="true" switches off
# authenticator-code sign-in for staff who have registered a key.
ADMIN_URL=""
STAFF_SECURITY_KEY_ONLY=""

# Production key protection (recommended): wrap the two keys above with AWS KMS using
# `npm run wrap-keys -w @kurotrace/admin`, set the output here, and delete the plain keys.
KMS_WRAPPED_KEYS=""
KMS_KEY_ID=""
KMS_REGION=""

# Ad measurement on campaign landing pages (/lp/*) only, after the visitor allows it.
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_TAG_ID=""                 # G-… (Analytics) or AW-… (Google Ads)
NEXT_PUBLIC_GOOGLE_ADS_LEAD_SEND_TO=""       # AW-123456789/AbCdEf conversion for "report started"
NEXT_PUBLIC_ADS_CONSENT="banner"             # "implied" skips the question; only with legal sign-off
META_CAPI_TOKEN=""                           # server-side Lead events (Conversions API), optional
META_TEST_EVENT_CODE=""                      # Meta Events Manager test code while checking setup

# ── Single-server deployment (deploy/docker-compose.yml) ──
SITE_DOMAIN=""                 # e.g. kurotrace.com
ADMIN_DOMAIN=""                # e.g. admin.kurotrace.com (keep it unlisted)
MYSQL_ROOT_PASSWORD=""         # long random value
MYSQL_APP_PASSWORD=""          # long random value
KEYS_SOURCE=""                 # "env" to acknowledge plain keys (no KMS)
# Backups: encrypted to this age public key (make one with `age-keygen`, keep the private key offline).
BACKUP_AGE_RECIPIENT=""
BACKUP_KEEP_DAYS="30"
# Off-site copy (docker compose --profile offsite): an S3 / R2 bucket
BACKUP_BUCKET=""
BACKUP_S3_PROVIDER="Cloudflare"  # or AWS
BACKUP_S3_ENDPOINT=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""

# Let search engines index the public pages. Leave unset until launch day.
SITE_INDEXABLE=""
