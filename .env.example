# Copy to .env (never commit .env). Generate keys with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Database (MySQL 8). Use separate least-privilege users for web and admin in production.
DATABASE_URL="mysql://demo_app:CHANGE_ME@localhost:3306/demo"

# Field encryption: ring of AES-256 keys, "keyId:base64key" comma-separated.
# The FIRST key encrypts new data; older keys stay for decryption during rotation.
# In production these come from the cloud KMS at boot, not from this file.
FIELD_ENCRYPTION_KEYS="k1:REPLACE_WITH_32_BYTE_BASE64_KEY"

# Separate key for blind indexes (lets us look up an email without storing it in plain text).
BLIND_INDEX_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"

# Public site URL (used for canonical URLs and cookies)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin terminal: comma-separated IPs or IPv4 CIDR ranges allowed to reach it.
ADMIN_ALLOWED_IPS="127.0.0.1,::1"
# Header that carries the real client IP. "cf-connecting-ip" behind Cloudflare.
# Only set this when the app is reachable exclusively through that proxy.
TRUSTED_IP_HEADER="x-forwarded-for"
