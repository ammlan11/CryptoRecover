{
  "name": "@kurotrace/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "create-owner": "tsx --env-file-if-exists=../../.env --conditions=react-server scripts/create-owner.ts",
    "scan-pending": "tsx --env-file-if-exists=../../.env --conditions=react-server scripts/scan-pending.ts",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "node test/e2e/admin-smoke.mjs",
    "wrap-keys": "tsx --env-file-if-exists=../../.env --conditions=react-server scripts/wrap-keys.ts",
    "demo": "tsx --env-file-if-exists=../../.env --conditions=react-server scripts/demo.ts",
    "sync-lists": "tsx --env-file-if-exists=../../.env --conditions=react-server scripts/sync-threat-lists.ts"
  },
  "dependencies": {
    "@kurotrace/core": "*",
    "@kurotrace/db": "*",
    "@kurotrace/services": "*",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "geist": "^1.9.1",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "@aws-sdk/client-kms": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
